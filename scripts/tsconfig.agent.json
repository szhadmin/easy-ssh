{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2022"],
    "types": ["node"],
    "skipLibCheck": true,
    "strict": false,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "outDir": "../.tmp-agent-cjs",
    "rootDir": "..",
    "baseUrl": "..",
    "paths": { "@shared/*": ["src/shared/*"] }
  },
  "include": [
    "../src/main/agent.ts",
    "../src/main/agent-bridge.ts",
    "../src/main/agent-memory.ts",
    "../src/shared/agent-roles.ts",
    "../src/shared/agent-tools.ts",
    "../src/shared/types.ts"
  ]
}
